if [ -f "$HOME/.bashrc.backup" ]; then
  source $HOME/.bashrc.backup
fi

#export PS1="\w$ "
export CLICOLOR=1
#export LANG="en_US"
#export LC_ALL="en_US"

alias ls="ls --color"

# Set new PATH
PATH="$HOME/.bin:$PATH"
[[ -n "$(which npm)" ]] && PATH="/usr/local/share/npm/bin:$PATH"
# ~/.bashrc is a symlink to <dotfiles>/ubuntu/bashrc.symlink; follow it to find the checkout.
if [ -z "$DOTFILES" ]; then
  _dotfiles_src="${BASH_SOURCE[0]}"
  [ -L "$_dotfiles_src" ] && _dotfiles_src="$(readlink "$_dotfiles_src")"
  DOTFILES="$(cd -P "$(dirname "$_dotfiles_src")/.." 2>/dev/null && pwd -P)"
  unset _dotfiles_src
fi
export DOTFILES
[[ -d "$DOTFILES/bin" ]] && PATH="$DOTFILES/bin:$PATH"
export PATH

# Open source
export CODE_PATH="$HOME/code"
export OCTO_URL="git@github.com:imathis/octopress.git"
export JEKYLL_URL="git://github.com/mojombo/jekyll.git"

clean_octo(){
  cd $CODE_PATH
  rm -rf ./octopress
  git clone $OCTO_URL octopress
  cd octopress
}

# Aliases for frequently-used commands
alias b="bundle"
alias be="bundle exec"
alias numfiles="ls -1 | wc -l"

