#!/usr/bin/env python3
"""Usage: op-to-bw [--vault PATH] [--dry-run] QUERY

Copies a Login from 1Password 7 to Bitwarden (Vaultwarden), creating it or
updating an existing entry of the same name.

QUERY is matched case-insensitively against Login names and URLs. The source
is PATH or $OPVAULT: either an .opvault vault file (prompts for the master
password; $OPVAULT_PASSWORD skips the prompt) or a 1Password 7 .1pif export
(File > Export > 1PIF; unencrypted, so delete it afterwards).

Requires: `brew install bitwarden-cli`.
Bitwarden must already point at your server (`bw config server URL`) and be
logged in (`bw login`); unlocking is prompted for.
"""
import argparse
import base64
import datetime
import getpass
import hashlib
import hmac
import json
import os
import pathlib
import struct
import subprocess
import sys

BW_TEXT, BW_HIDDEN = 0, 1


def die(msg):
    sys.exit(f"error: {msg}")


def run(cmd, stdin=None, interactive=False):
    """Runs cmd, returns stdout. Interactive keeps the tty for prompts."""
    try:
        p = subprocess.run(
            cmd,
            input=stdin,
            text=True,
            stdout=subprocess.PIPE,
            stderr=None if interactive else subprocess.PIPE,
        )
    except FileNotFoundError:
        die(f"`{cmd[0]}` not found; install it with Homebrew")
    if p.returncode != 0:
        die(f"`{' '.join(cmd[:3])}` failed: {(p.stderr or '').strip()}")
    return p.stdout


def run_json(cmd, **kw):
    return json.loads(run(cmd, **kw))


# 1Password (OPVault)


class BadMAC(Exception):
    pass


def _aes_tables():
    exp, log, x = [0] * 255, [0] * 256, 1
    for i in range(255):
        exp[i], log[x] = x, i
        x ^= ((x << 1) ^ (0x1B if x & 0x80 else 0)) & 0xFF  # x *= 3
    rotl = lambda v, n: ((v << n) | (v >> (8 - n))) & 0xFF
    sbox = [0x63] * 256
    for i in range(1, 256):
        v = exp[(255 - log[i]) % 255]
        sbox[i] = v ^ rotl(v, 1) ^ rotl(v, 2) ^ rotl(v, 3) ^ rotl(v, 4) ^ 0x63
    inv = [0] * 256
    for i, v in enumerate(sbox):
        inv[v] = i

    def mul(a, b):
        return exp[(log[a] + log[b]) % 255] if a and b else 0

    td0 = [
        mul(v, 14) << 24 | mul(v, 9) << 16 | mul(v, 13) << 8 | mul(v, 11)
        for v in inv
    ]
    ror8 = lambda w: (w >> 8) | ((w & 0xFF) << 24)
    td1 = [ror8(w) for w in td0]
    td2 = [ror8(w) for w in td1]
    td3 = [ror8(w) for w in td2]
    return sbox, inv, td0, td1, td2, td3


SBOX, ISBOX, TD0, TD1, TD2, TD3 = _aes_tables()


def _aes256_decrypt_keys(key):
    """Expands a 32-byte key into round keys for the equivalent inverse cipher."""
    w = list(struct.unpack(">8I", key))
    rcon = 1
    for i in range(8, 60):
        t = w[i - 1]
        if i % 8 == 0:
            t = (t << 8 | t >> 24) & 0xFFFFFFFF
            t = sum(SBOX[(t >> s) & 0xFF] << s for s in (24, 16, 8, 0)) ^ (rcon << 24)
            rcon = ((rcon << 1) ^ (0x1B if rcon & 0x80 else 0)) & 0xFF
        elif i % 8 == 4:
            t = sum(SBOX[(t >> s) & 0xFF] << s for s in (24, 16, 8, 0))
        w.append(w[i - 8] ^ t)
    dk = []
    for r in range(14, -1, -1):
        words = w[4 * r : 4 * r + 4]
        if 0 < r < 14:  # InvMixColumns
            words = [
                TD0[SBOX[x >> 24]] ^ TD1[SBOX[(x >> 16) & 0xFF]] ^ TD2[SBOX[(x >> 8) & 0xFF]] ^ TD3[SBOX[x & 0xFF]]
                for x in words
            ]
        dk += words
    return dk


def _aes_decrypt_block(dk, block):
    s0, s1, s2, s3 = (a ^ b for a, b in zip(struct.unpack(">4I", block), dk))
    for r in range(4, 56, 4):
        s0, s1, s2, s3 = (
            TD0[s0 >> 24] ^ TD1[(s3 >> 16) & 255] ^ TD2[(s2 >> 8) & 255] ^ TD3[s1 & 255] ^ dk[r],
            TD0[s1 >> 24] ^ TD1[(s0 >> 16) & 255] ^ TD2[(s3 >> 8) & 255] ^ TD3[s2 & 255] ^ dk[r + 1],
            TD0[s2 >> 24] ^ TD1[(s1 >> 16) & 255] ^ TD2[(s0 >> 8) & 255] ^ TD3[s3 & 255] ^ dk[r + 2],
            TD0[s3 >> 24] ^ TD1[(s2 >> 16) & 255] ^ TD2[(s1 >> 8) & 255] ^ TD3[s0 & 255] ^ dk[r + 3],
        )
    return struct.pack(
        ">4I",
        (ISBOX[s0 >> 24] << 24 | ISBOX[(s3 >> 16) & 255] << 16 | ISBOX[(s2 >> 8) & 255] << 8 | ISBOX[s1 & 255]) ^ dk[56],
        (ISBOX[s1 >> 24] << 24 | ISBOX[(s0 >> 16) & 255] << 16 | ISBOX[(s3 >> 8) & 255] << 8 | ISBOX[s2 & 255]) ^ dk[57],
        (ISBOX[s2 >> 24] << 24 | ISBOX[(s1 >> 16) & 255] << 16 | ISBOX[(s0 >> 8) & 255] << 8 | ISBOX[s3 & 255]) ^ dk[58],
        (ISBOX[s3 >> 24] << 24 | ISBOX[(s2 >> 16) & 255] << 16 | ISBOX[(s1 >> 8) & 255] << 8 | ISBOX[s0 & 255]) ^ dk[59],
    )


def cbc_decrypt(key, jobs):
    """AES-256-CBC-decrypts [(iv, ciphertext)]. Pure Python, so keys never hit argv."""
    dk = _aes256_decrypt_keys(key)
    out = []
    for iv, ct in jobs:
        prev, plain = iv, []
        for i in range(0, len(ct), 16):
            block = ct[i : i + 16]
            d = _aes_decrypt_block(dk, block)
            plain.append((int.from_bytes(d, "big") ^ int.from_bytes(prev, "big")).to_bytes(16, "big"))
            prev = block
        out.append(b"".join(plain))
    return out


def opdata_decrypt(blobs, enc, mac):
    """Decrypts "opdata01" blobs (raw or base64): header, length, IV, data, HMAC."""
    jobs, sizes = [], []
    for blob in blobs:
        raw = blob if blob.startswith(b"opdata01") else base64.b64decode(blob)
        if not hmac.compare_digest(hmac.digest(mac, raw[:-32], "sha256"), raw[-32:]):
            raise BadMAC
        jobs.append((raw[16:32], raw[32:-32]))
        sizes.append(int.from_bytes(raw[8:16], "little"))
    # Plaintext is prefixed with random padding.
    return [p[len(p) - n :] for p, n in zip(cbc_decrypt(enc, jobs), sizes)]


def split_keys(material):
    return material[:32], material[32:]


def read_js(path):
    """Reads the JSON object out of `var x={...};` / `ld({...});` files."""
    text = path.read_text()
    return json.loads(text[text.index("{") : text.rindex("}") + 1])


def open_source(arg):
    """Opens a 1Password 7 .opvault, or an unencrypted .1pif export (file or folder)."""
    path = arg or os.environ.get("OPVAULT")
    if not path:
        try:  # Spotlight, on macOS
            out = subprocess.run(["mdfind", "-name", ".opvault"], capture_output=True, text=True).stdout
        except FileNotFoundError:
            out = ""
        found = [p for p in out.splitlines() if p.endswith(".opvault")]
        if not found:
            die("no vault found; pass --vault PATH (an .opvault or .1pif) or set $OPVAULT")
        path = found[0] if len(found) == 1 else found[choose("Which vault?", found)]
    root = pathlib.Path(path).expanduser()
    if root.is_dir() and (root / "data.1pif").exists():
        return Pif(root / "data.1pif")
    if root.is_file() and root.suffix == ".1pif":
        return Pif(root)
    for profile in (root / "default", root):
        if (profile / "profile.js").exists():
            return Vault(profile)
    die(f"{root} is not an .opvault or .1pif export")


class Vault:
    def __init__(self, path):
        self.path = path
        profile = read_js(path / "profile.js")
        password = os.environ.get("OPVAULT_PASSWORD") or getpass.getpass("1Password master password: ")
        derived = hashlib.pbkdf2_hmac(
            "sha512", password.encode(), base64.b64decode(profile["salt"]), profile["iterations"], 64
        )
        try:
            self.master = self._unlock(profile["masterKey"], derived)
            self.overview = self._unlock(profile["overviewKey"], derived)
        except BadMAC:
            die("wrong 1Password master password")

    @staticmethod
    def _unlock(blob, derived):
        material = opdata_decrypt([blob.encode()], *split_keys(derived))[0]
        return split_keys(hashlib.sha512(material).digest())

    def logins(self):
        """Returns non-trashed Logins as {"overview", "item"} dicts."""
        items = []
        for band in sorted(self.path.glob("band_*.js")):
            items += [i for i in read_js(band).values() if i["category"] == "001" and not i.get("trashed")]
        overviews = opdata_decrypt([i["o"].encode() for i in items], *self.overview)
        return [{"item": i, "overview": json.loads(o)} for i, o in zip(items, overviews)]

    def details(self, entry):
        item = entry["item"]
        k = base64.b64decode(item["k"])
        if not hmac.compare_digest(hmac.digest(self.master[1], k[:80], "sha256"), k[80:]):
            raise BadMAC
        (key,) = cbc_decrypt(self.master[0], [(k[:16], k[16:80])])
        return json.loads(opdata_decrypt([item["d"].encode()], *split_keys(key))[0])


class Pif:
    """A 1Password Interchange Format export: JSON items split by a marker line."""

    SEPARATOR = "***5642bee8-a5ff-11dc-8314-0800200c9a66***"

    def __init__(self, path):
        self.path = path

    def logins(self):
        entries = []
        for chunk in self.path.read_text().split(self.SEPARATOR):
            if not chunk.strip():
                continue
            item = json.loads(chunk)
            if item.get("typeName") != "webforms.WebForm" or item.get("trashed"):
                continue
            details = item.get("secureContents", {})
            username = next((f.get("value") for f in details.get("fields", []) if f.get("designation") == "username"), None)
            overview = {
                "title": item.get("title"),
                "url": item.get("location"),
                "URLs": [{"u": u.get("url")} for u in details.get("URLs", [])],
                "ainfo": username,
            }
            entries.append({"overview": overview, "details": details})
        return entries

    def details(self, entry):
        return entry["details"]


def urls_of(overview):
    urls = [overview.get("url")] + [u.get("u") for u in overview.get("URLs", [])]
    return list(dict.fromkeys(u for u in urls if u))


def search(logins, query):
    q = query.lower()
    return [
        entry for entry in logins
        if q in entry["overview"].get("title", "").lower()
        or any(q in u.lower() for u in urls_of(entry["overview"]))
    ]


def describe(login):
    o = login["overview"]
    url = (urls_of(o) or [""])[0]
    return f"{o.get('title')}  ({o.get('ainfo') or '-'})  {url[:60]}".rstrip()


def choose(prompt, labels):
    """Prints a numbered menu and returns the 0-based index chosen."""
    for n, label in enumerate(labels, 1):
        print(f"  {n}) {label}", file=sys.stderr)
    while True:
        answer = input(f"{prompt} [1-{len(labels)}]: ").strip()
        if answer.isdigit() and 1 <= int(answer) <= len(labels):
            return int(answer) - 1


def field_text(kind, value):
    if kind == "date" and isinstance(value, int):
        return datetime.datetime.fromtimestamp(value, datetime.timezone.utc).strftime("%Y-%m-%d")
    if isinstance(value, dict):
        return ", ".join(f"{k}: {v}" for k, v in value.items() if v)
    return str(value)


def to_bw_login(overview, details):
    """Maps decrypted 1Password Login data to Bitwarden login, notes and fields."""
    login = {"username": None, "password": None, "totp": None, "uris": []}
    for f in details.get("fields", []):
        if f.get("designation") in ("username", "password") and f.get("value"):
            login[f["designation"]] = f["value"]
    fields = []
    for section in details.get("sections", []):
        for f in section.get("fields", []):
            value = f.get("v")
            if value in (None, ""):
                continue
            if f["k"] == "totp" or str(f.get("n", "")).startswith("TOTP_"):
                login["totp"] = login["totp"] or value
                continue
            label = f.get("t") or f.get("n") or "Field"
            if section.get("title"):
                label = f"{section['title']}: {label}"
            kind = BW_HIDDEN if f["k"] == "concealed" else BW_TEXT
            fields.append({"name": label, "value": field_text(f["k"], value), "type": kind})
    login["uris"] = [{"match": None, "uri": u} for u in urls_of(overview)]
    return overview["title"], login, details.get("notesPlain"), fields


# Bitwarden


def bw_unlock():
    # `bw status` honors $BW_SESSION, so a stale session reads as "locked".
    status = run_json(["bw", "status"]).get("status")
    if status == "unauthenticated":
        die("not logged in to Bitwarden; run `bw config server URL && bw login`")
    if status == "locked":
        os.environ["BW_SESSION"] = run(["bw", "unlock", "--raw"], interactive=True).strip()
    run(["bw", "sync"])  # so existing entries are found


def bw_find(name):
    items = run_json(["bw", "list", "items", "--search", name])
    return [i for i in items if i["type"] == 1 and i["name"].lower() == name.lower()]


def bw_save(payload, existing_id=None):
    """Writes the item; the JSON goes over stdin to keep secrets out of `ps`."""
    encoded = base64.b64encode(json.dumps(payload).encode()).decode()
    cmd = ["bw", "edit", "item", existing_id] if existing_id else ["bw", "create", "item"]
    run(cmd + ["--raw"], stdin=encoded)


def build_payload(existing, name, login, notes, fields):
    item = existing or {
        "type": 1,
        "organizationId": None,
        "folderId": None,
        "favorite": False,
        "login": {},
    }
    item["name"] = name
    uris = login.pop("uris")
    item["login"].update({k: v for k, v in login.items() if v})
    known = {u["uri"] for u in item["login"].get("uris") or []}
    item["login"]["uris"] = (item["login"].get("uris") or []) + [u for u in uris if u["uri"] not in known]
    if notes:
        item["notes"] = notes
    # 1Password wins on name clashes; other existing custom fields are kept.
    new_names = {f["name"] for f in fields}
    kept = [f for f in item.get("fields") or [] if f["name"] not in new_names]
    item["fields"] = kept + fields
    return item


def main():
    ap = argparse.ArgumentParser(description="Copy a 1Password Login to Bitwarden.")
    ap.add_argument("query")
    ap.add_argument("--vault", help=".opvault or .1pif export (default: $OPVAULT, else Spotlight)")
    ap.add_argument("-n", "--dry-run", action="store_true", help="show the plan; write nothing")
    args = ap.parse_args()

    vault = open_source(args.vault)
    matches = search(vault.logins(), args.query)
    if not matches:
        die(f"no 1Password Logins match {args.query!r}")
    if len(matches) == 1:
        selected = matches[0]
        print(f"Found: {describe(selected)}", file=sys.stderr)
    else:
        print(f"{len(matches)} Logins match {args.query!r}:", file=sys.stderr)
        selected = matches[choose("Copy which?", [describe(m) for m in matches])]

    name, login, notes, fields = to_bw_login(selected["overview"], vault.details(selected))

    bw_unlock()
    existing_matches = bw_find(name)
    existing = None
    if len(existing_matches) == 1:
        existing = existing_matches[0]
    elif existing_matches:
        print(f"{len(existing_matches)} Bitwarden Logins are named {name!r}:", file=sys.stderr)
        labels = [f"update: {e['name']} ({e['login'].get('username') or '-'})" for e in existing_matches]
        i = choose("Which?", labels + ["create a new entry"])
        existing = existing_matches[i] if i < len(existing_matches) else None

    action = "Update" if existing else "Create"
    summary = f"{action} {name!r}: {len(login['uris'])} URI(s), {len(fields)} custom field(s)"
    if args.dry_run:
        print(f"[dry run] {summary}", file=sys.stderr)
        return
    bw_save(build_payload(existing, name, login, notes, fields), existing and existing["id"])
    print(f"{summary} -- done", file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        sys.exit(130)
    except BadMAC:
        die("vault data failed its integrity check; the vault may be corrupt")
